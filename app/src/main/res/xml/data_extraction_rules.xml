<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <!-- 换机传输仍带上设置；云备份不上传饼干 -->
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="offline_images/" />
    </device-transfer>
</data-extraction-rules>
